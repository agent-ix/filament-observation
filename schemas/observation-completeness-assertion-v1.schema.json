{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:agent-ix:filament-observation:completeness-assertion:1",
  "title": "Observation completeness assertion owner artifact v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "identity", "revision", "authority", "subject", "payload", "predecessor", "limits"],
  "properties": {
    "contract": {"const": "filament.observation.completeness-assertion/v1"}, "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "revision": {"type": "integer", "minimum": 1}, "authority": {"$ref": "observation-record-v1.schema.json#/$defs/authority"}, "subject": {"$ref": "observation-record-v1.schema.json#/$defs/subject"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["population_identity", "boundary_identity", "boundary", "basis", "facts", "state"], "properties": {"population_identity": {"type": "string", "minLength": 1}, "boundary_identity": {"type": "string", "minLength": 1}, "boundary": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["clock_family", "lower", "upper_inclusive", "carrier_end_exclusive", "watermark"], "properties": {"clock_family": {"const": "event-position"}, "lower": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "upper_inclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "carrier_end_exclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "watermark": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}}}, {"type": "object", "additionalProperties": false, "required": ["clock_family", "lower", "upper_inclusive", "carrier_end_exclusive", "watermark"], "properties": {"clock_family": {"const": "fixed-sample"}, "lower": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "upper_inclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "carrier_end_exclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "watermark": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}}}, {"type": "object", "additionalProperties": false, "required": ["clock_family", "lower_nanos", "upper_inclusive_nanos", "carrier_end_exclusive_nanos", "watermark_nanos"], "properties": {"clock_family": {"const": "timestamped-event"}, "lower_nanos": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}, "upper_inclusive_nanos": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}, "carrier_end_exclusive_nanos": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}, "watermark_nanos": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}}}]}, "basis": {"enum": ["derived", "revised"]}, "facts": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["member_identity", "observation_identity", "status", "origin"], "properties": {"member_identity": {"type": "string", "minLength": 1}, "observation_identity": {"type": ["string", "null"]}, "status": {"enum": ["available", "incomplete", "contradicted"]}, "origin": {"enum": ["selected", "carried"]}}}}, "state": {"enum": ["complete", "incomplete", "contradicted"]}}},
    "predecessor": {"$ref": "observation-record-v1.schema.json#/$defs/predecessor"}, "limits": {"$ref": "observation-record-v1.schema.json#/$defs/limits"}
  }
}
