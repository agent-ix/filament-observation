{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ix:filament-observation:rt-event:1",
  "title": "Runtime event input line",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "record", "reading", "inputs"],
  "properties": {
    "contract": {"const": "filament.observation.rt-event/v1"},
    "record": {"$ref": "record-candidate-v1.schema.json"},
    "reading": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "inputs": {"type": "string"}
  }
}
